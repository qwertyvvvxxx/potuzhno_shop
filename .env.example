# ──────────────────────────────────────────────────────────────
# Шаблон змінних оточення.
# Скопіюй цей файл у .env і підстав свої значення:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# Файл .env у git НЕ потрапляє (див. .gitignore).
# Один і той самий .env читають і локальний runserver, і docker compose.
# ──────────────────────────────────────────────────────────────

# Django
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=змінити-на-випадковий-рядок
# Локально True; у Docker compose завжди примусово False
DJANGO_DEBUG=True
# Для сервера додай свій домен через кому: 127.0.0.1,localhost,shop.example.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
POSTGRES_DB=potuzhno_shop
POSTGRES_USER=potuzhno_shop
POSTGRES_PASSWORD=potuzhno_shop
# Локально — своя база на цій машині; у Docker compose підставляє host "db"
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
